# Copy to .env on the deployment host and fill real secrets there.

BACKEND_PORT=8081

MYSQL_PORT=3306
MYSQL_DATABASE=career_pilot
MYSQL_ROOT_PASSWORD=replace-with-strong-database-password

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=career-pilot
JWT_EXPIRATION_SECONDS=86400

AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_QUOTA_ENABLED=true
AI_DAILY_LIMIT=20

SQL_INIT_MODE=never
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
